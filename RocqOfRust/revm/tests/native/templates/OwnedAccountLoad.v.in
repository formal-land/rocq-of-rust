From Stdlib Require Import List ZArith.
Require Import RocqOfRust.revm.revm_interpreter.tests.stateful_host.
Require Import RocqOfRust.revm.revm_interpreter.instructions.contract.simulate.account_load.
Require Import RocqOfRust.revm.revm_context_interface.simulate.journaled_state.
Require Import RocqOfRust.simulate.RocqOfRust.
Require Import RocqOfRust.alloy_primitives.bits.links.address.
Require Import RocqOfRust.alloy_primitives.bytes.links.mod.
Require Import RocqOfRust.alloy_primitives.bytes.simulate.mod.
Require Import RocqOfRust.alloy_primitives.links.aliases.
Require Import RocqOfRust.bytes.links.bytes.
Require Import RocqOfRust.core.links.result.
Require Import RocqOfRust.revm.revm_bytecode.links.bytecode.
Require Import RocqOfRust.revm.revm_context_interface.links.host.
Require Import RocqOfRust.revm.revm_context_interface.links.journaled_state.
Require Import RocqOfRust.revm.revm_context_interface.simulate.host.
Require Import RocqOfRust.revm.revm_context_interface.simulate.journaled_state.
Require Import RocqOfRust.revm.revm_interpreter.gas.simulate.constants.
Require Import RocqOfRust.revm.revm_primitives.links.hardfork.
Require Import RocqOfRust.revm.revm_primitives.simulate.hardfork.
Require Import RocqOfRust.simulate.RocqOfRust.

Import ListNotations.
Open Scope Z_scope.

Definition native_load_owned (host : StatefulHost.t) (spec : SpecId.t)
    (remaining_gas : u64) (address : Address.t)
    (transfers_value create_empty_account : bool) :=
  let is_berlin := Impl_SpecId.is_enabled_in spec SpecId.BERLIN in
  let skip_cold := is_berlin &&
    (remaining_gas.(Integer.value) <? COLD_ACCOUNT_ACCESS_COST_ADDITIONAL.(Integer.value)) in
  if skip_cold && negb (StatefulHost.account_is_warm host address.(Address.value)) then
    (Result.Err LoadError.ColdLoadSkipped, host)
  else
    let account := StatefulHost.account_info_load host address true in
    let host := StatefulHost.warm_account host address.(Address.value) in
    let cost : u64 := if is_berlin && account.(AccountInfoLoad.is_cold)
      then COLD_ACCOUNT_ACCESS_COST_ADDITIONAL else 0 in
    let code := loaded_bytecode account in
    let hash := account_info_load_code_hash account in
    if create_empty_account && account.(AccountInfoLoad.is_empty) then
      (Result.Ok
        (cost +i new_account_cost
          (Impl_SpecId.is_enabled_in spec SpecId.SPURIOUS_DRAGON)
          transfers_value, code, hash), host)
    else
      match delegated_address code with
      | None => (Result.Ok (cost, code, hash), host)
      | Some delegate =>
          let cost := cost +i WARM_STORAGE_READ_COST in
          if remaining_gas.(Integer.value) <? cost.(Integer.value) then
            (Result.Err LoadError.ColdLoadSkipped, host)
          else
            let skip_cold := remaining_gas.(Integer.value) <?
              (cost +i COLD_ACCOUNT_ACCESS_COST_ADDITIONAL).(Integer.value) in
            if skip_cold && negb (StatefulHost.account_is_warm host delegate.(Address.value)) then
              (Result.Err LoadError.ColdLoadSkipped, host)
            else
              let delegate_info := StatefulHost.account_info_load host delegate true in
              let host := StatefulHost.warm_account host delegate.(Address.value) in
              let cost := if delegate_info.(AccountInfoLoad.is_cold)
                then cost +i COLD_ACCOUNT_ACCESS_COST_ADDITIONAL else cost in
              (Result.Ok (cost, loaded_bytecode delegate_info,
                account_info_load_code_hash delegate_info), host)
      end.

Lemma native_load_owned_eq (host : StatefulHost.t) (spec : SpecId.t)
    (remaining_gas : u64) (address : Address.t)
    (transfers_value create_empty_account : bool) :
  native_load_owned host spec remaining_gas address transfers_value create_empty_account =
  account_load.load_account_delegated (H_types := StatefulHost.host_types)
    host spec remaining_gas address transfers_value create_empty_account.
Proof.
  unfold native_load_owned, account_load.load_account_delegated.
  cbv beta iota zeta delta [StatefulHost.HostForRevmHost Host.load_account_info_skip_cold_load
    StatefulHost.load_account_info_skip_cold_load].
  repeat match goal with
  | |- context[if ?condition then _ else _] => destruct condition eqn:?
  | |- context[match delegated_address ?code with _ => _ end] => destruct (delegated_address code) eqn:?
  end; reflexivity.
Qed.
