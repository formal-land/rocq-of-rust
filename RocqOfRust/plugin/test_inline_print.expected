         Ty.apply (Ty.path "debug::Generic") [] [T'0] =
         (DebugGeneric.IsLink
            {| OfTy.A := A; OfTy.H := H; OfTy.eq := eq1 |}.(OfTy.A))
         .(Φ _))
        ((eq_refl
          :
          Ty.apply (Ty.path "debug::Generic") [] [H.(Φ _)] =
          (DebugGeneric.IsLink
             {| OfTy.A := A; OfTy.H := H; OfTy.eq := eq_refl |}.(OfTy.A))
          .(Φ _))
         :
         Ty.apply (Ty.path "debug::Generic") [] [H.(Φ _)] =
         (DebugGeneric.IsLink
            {| OfTy.A := A; OfTy.H := H; OfTy.eq := eq_refl |}.(OfTy.A))
         .(Φ _))
        eq0)
       H_T.(OfTy.A) H_T.(OfTy.H) H_T.(OfTy.eq)
     :
     Ty.apply (Ty.path "debug::Generic") [] [T'] =
     (DebugGeneric.IsLink H_T.(OfTy.A)).(Φ _))
    :
    Ty.apply (Ty.path "debug::Generic") [] [T'] =
    (DebugGeneric.IsLink H_T.(OfTy.A)).(Φ _)
|}
